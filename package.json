{
  "name": "contentfactoryai",
  "version": "0.1.0",
  "description": "Multi-agent platform for automated audiovisual content production",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "content-creation",
    "multi-agent",
    "video-generation"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
